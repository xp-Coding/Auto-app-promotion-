# AppGrowth Studio + ViMax AI Video Generation Engine
# -----------------------------------------------------------------
# 100% Free & Local by default: When no API keys are provided,
# ViMax runs in local procedural graphics & Windows SAPI/Edge-TTS mode.
# Zero paid subscriptions required.

# Server Configuration
VIMAX_PORT=8765
VIMAX_HOST=127.0.0.1
DEBUG=False

# Optional: Language Model Provider (for enhanced agentic generation)
# Supports: openai, deepseek, local (default)
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Generative Image Providers
# Supports: local_procedural (default, free), dall-e-3, stability
IMAGE_PROVIDER=local_procedural
STABILITY_API_KEY=

# Optional: Generative Video Providers
# Supports: local_compositor (default, free), pika, runway, kling
VIDEO_PROVIDER=local_compositor
PIKA_API_KEY=
RUNWAY_API_KEY=

# Speech Synthesis Engine
# Supports: sapi (Windows Native, free), edge-tts (free online), openai
TTS_PROVIDER=sapi
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Resource Controls & Five Videos Per Day Target
MAX_DAILY_VIDEOS=5
MAX_CONCURRENT_JOBS=1
CLEANUP_TEMP_FILES_AFTER_RENDER=true
